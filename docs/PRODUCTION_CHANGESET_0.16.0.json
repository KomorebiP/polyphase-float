{
  "added_files": [],
  "baseline_version": "0.15.0",
  "change_boundary": {
    "constant_internal.h": "Pass the active context into constant interval builders and expose an internal interval swap used for atomic cache commit.",
    "constant_log2.c": "Route packet arrays through provenance-carrying context allocation and preallocate all worker scratch before OpenMP execution.",
    "constant_pi.c": "Route embedded-core C work arrays through the active context, synchronize context publication with worker callbacks, and select the exact non-adic Chudnovsky execution path for the governed public builder.",
    "constants.c": "Stage caller destinations, distinguish new allocation failures from sticky state, and commit exact and rounded caches only after complete construction.",
    "context.c": "Add project-allocation failure epochs and allocator-provenance temporary buffers with exact realloc and free callbacks.",
    "io.c": "Record direct PPFIF export allocation failure in the internal project-allocation epoch.",
    "object.c": "Record direct object-reserve reallocation failure in the internal project-allocation epoch.",
    "polyphase_chudnovsky_core.c": "Make C heap calls overridable, keep GMP-owned decimal strings in the GMP allocator domain, replace selected process-fatal allocation exits with clean failure returns, and update embedded version metadata.",
    "ppf_internal.h": "Declare internal project-allocation failure-epoch and allocator-provenance buffer helpers.",
    "special_common.c": "Route Euler and Catalan builder work through a caller-derived wide context and propagate nested allocation failure."
  },
