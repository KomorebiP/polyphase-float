  "change_boundary": {
    "arithmetic_root_transaction.c": "Provide 56 public transactional wrappers, including inline common-precision staging and a complete batch commit for ppf_div_with_plan_many.",
    "polyphase_chudnovsky_core.c": "Update embedded release metadata only.",
    "ppf_internal.h": "Declare inline and batch result-transaction helpers and include the private arithmetic/root implementation-name mapping.",
    "result_transaction.c": "Add inline fixed-limb staging and validated all-or-nothing batch commit while preserving the existing heap-staged transaction path.",
    "transactional_arithmetic_root_names.h": "Map arithmetic, fused/planned-operation, and root implementation definitions and internal calls to private uncommitted names.",
    "transactional_impl_prototypes.h": "Declare the 56 private uncommitted arithmetic, fused/planned-operation, and root entry points."
  },
