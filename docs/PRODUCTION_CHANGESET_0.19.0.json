  "change_boundary": {
    "assignment.c": "Reject empty text and invalid rounding; conservatively classify large exponents with significand size; correct directed underflow.",
    "format.c": "Reject the unrepresentable absolute value of minimum signed dynamic width without overflow or buffer mutation.",
    "object.c": "Exclude infinities from the finite-number predicate.",
    "polyphase_chudnovsky_core.c": "Update release version metadata only.",
    "random.c": "Stage five random endpoints and clean partially initialized scratch without rolling back RNG state.",
    "remainder.c": "Make scalar unsigned remainder transactional and propagate working-context allocation errors.",
    "round.c": "Stage precision changes and interval assignment; preserve external storage; correct directed sign reversal and error sentinel handling.",
    "runtime_support.c": "Stage relative difference; clear partially initialized rounding scratch; validate signed custom kind safely.",
    "special_bessel.c": "Correct parity, interval endpoint and factorial direction; bound finite order safely; enclose Airy coefficients.",
    "special_common.c": "Provide private decreasing-Gamma and positive-tail interval helpers.",
    "special_gamma.c": "Add exact integer identities, correct special values and flags, preserve reflection intervals and validate exact transforms.",
    "special_internal.h": "Declare private enclosure helpers without changing public ABI.",
    "special_misc.c": "Correct positive-tail majorants and transformed Li2 and zeta certificates.",
    "transcendental_fast.c": "Initialize cleanup loop bound explicitly for warning hygiene without altering numerical logic."
  },
