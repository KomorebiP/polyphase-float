prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: polyphase-float-mpfr
Description: Optional MPFR interoperability adapter for Polyphase Float
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lpolyphase_float_mpfr
Cflags: -I${includedir}
Requires: polyphase-float mpfr
